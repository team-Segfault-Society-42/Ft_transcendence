root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,tsx,js,jsx,css,html}]
indent_style = tab
tab_width = 2

[*.{json,jsonc,yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab